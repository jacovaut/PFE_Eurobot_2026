<?xml version="1.0"?>
<robot name="pfe_robot">

  <!-- ===================== ROS BASE ===================== -->
  <link name="base_link"/>

  <!-- ===================== CAD WRAPPER ===================== -->
  <link name="base_cad">
    <inertial>
      <origin xyz="-0.18129580587395977 0.11002670866229906 -0.09830960898232394" rpy="0 0 0"/>
      <mass value="10.931310813599758"/>
      <inertia ixx="0.1162758217320149"
               iyy="0.15792001930992816"
               izz="0.15341594762610528"
               ixy="0.0006562989752065123"
               iyz="-0.0005062993369034275"
               ixz="0.009839529045043937"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://match/meshes/base_link-v5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://match/meshes/base_link-v5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Fusion: +x backward, +y right -->
  <joint name="base_to_cad" type="fixed">
    <parent link="base_link"/>
    <child link="base_cad"/>
    <origin xyz="-0.1689 0.1100 0" rpy="0 0 3.141592653589793"/>
  </joint>

  <!-- ===================== ARM ===================== -->
  <link name="arm_link">
    <inertial>
      <origin xyz="-9.798976132702034e-16 -2.2996226341901397e-07 0.003266587610266396" rpy="0 0 0"/>
      <mass value="0.5338474560099968"/>
      <inertia ixx="0.0009599083468218418"
               iyy="0.0002203089102536459"
               izz="0.0011328418152016686"
               ixy="5.970780693414603e-17"
               iyz="-9.724324403256641e-10"
               ixz="-6.801394570971657e-18"/>
    </inertial>

    <!-- kept original visual transform to preserve cup frame convention -->
    <visual>
      <origin xyz="9.349037100037094e-10 0.004999995232077037 0.03650000482135752"
              rpy="1.5707963267948963 1.5707963267948957 0"/>
      <geometry>
        <mesh filename="package://match/meshes/arm_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="9.349037100037094e-10 0.004999995232077037 0.03650000482135752"
              rpy="1.5707963267948963 1.5707963267948957 0"/>
      <geometry>
        <mesh filename="package://match/meshes/arm_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="arm_joint" type="continuous">
    <parent link="base_cad"/>
    <child link="arm_link"/>
    <origin xyz="-0.4009156752862411 0.107293206200904699 -0.15465636918407304"
            rpy="-1.5707963267948974 -1.5265566588595922e-16 7.21644966006352e-16"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ===================== FLIPPER ===================== -->
  <link name="flipper_link">
    <inertial>
      <origin xyz="2.6474475234294913e-09 4.767925592119582e-09 -0.07580524145430977" rpy="0 0 0"/>
      <mass value="0.4797185340176825"/>
      <inertia ixx="0.0011969873864993257"
               iyy="0.0009456324882451857"
               izz="0.0002533232197152197"
               ixy="-1.3010426069826053e-18"
               iyz="1.734723475976807e-18"
               ixz="1.7802599672211983e-16"/>
    </inertial>

    <visual>
      <origin xyz="0.00861550378970137 0.01247089554740951 -0.07550000482135592"
              rpy="-1.5707963267948968 -1.5707963267947291 0"/>
      <geometry>
        <mesh filename="package://match/meshes/flipper_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0.00861550378970137 0.01247089554740951 -0.07550000482135592"
              rpy="-1.5707963267948968 -1.5707963267947291 0"/>
      <geometry>
        <mesh filename="package://match/meshes/flipper_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="flipper_joint" type="continuous">
    <parent link="base_cad"/>
    <child link="flipper_link"/>
    <origin xyz="-0.0164154352862412 0.03393206200904719 -0.13965336918407295"
            rpy="1.5707963267948957 -1.5265566588595922e-16 7.21644966006352e-16"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ===================== MECANUM WHEELS ===================== -->
  <link name="front_left_wheel_link">
    <visual>
      <geometry>
        <mesh filename="package://match/meshes/wheel_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://match/meshes/wheel_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="rear_left_wheel_link">
    <visual>
      <geometry>
        <mesh filename="package://match/meshes/wheel_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://match/meshes/wheel_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="rear_right_wheel_link">
    <visual>
      <geometry>
        <mesh filename="package://match/meshes/wheel_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://match/meshes/wheel_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="front_right_wheel_link">
    <visual>
      <geometry>
        <mesh filename="package://match/meshes/wheel_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://match/meshes/wheel_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_cad"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="-0.2329295352862411 -0.01429999799095302 -0.15665336918407297"
            rpy="1.5707963267948957 -1.5265566588595922e-16 7.21644966006352e-16"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_cad"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="-0.10492999528624117 -0.01429999799095293 -0.1566533691840729"
            rpy="1.5707963267948957 -1.5265566588595922e-16 7.21644966006352e-16"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_cad"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="-0.10490178528624114 0.23430000200904744 -0.15665336918407313"
            rpy="-1.5707963267948941 -1.5265566588595922e-16 7.21644966006352e-16"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_cad"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="-0.23290132528624108 0.23430000200904733 -0.15665336918407316"
            rpy="-1.5707963267948974 -1.5265566588595922e-16 7.21644966006352e-16"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ===================== CAMERA ===================== -->
  <link name="arducam_link">
    <inertial>
      <origin xyz="-0.00013322161290098224 0.0009504573350092649 0.00043137020324471645" rpy="0 0 0"/>
      <mass value="0.0010174438167060709"/>
      <inertia ixx="4.5307132551562007e-08"
               iyy="3.5090242032863035e-08"
               izz="7.59611441794051e-08"
               ixy="1.0347644394329782e-09"
               iyz="-2.264070327162072e-09"
               ixz="1.3166586418150303e-10"/>
    </inertial>

    <visual>
      <origin xyz="3.328162776483623e-09 -0.0026249951786425996 -0.0012500022897735264"
              rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://match/meshes/arducam_link-v3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="3.328162776483623e-09 -0.0026249951786425996 -0.0012500022897735264"
              rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://match/meshes/arducam_link-v3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_arducam" type="fixed">
    <parent link="base_cad"/>
    <child link="arducam_link"/>
    <origin xyz="-0.2678761652862411 0.16593206200904703 0.06147094081592663"
            rpy="-3.1415926535897922 -0.6973907898697068 -3.141592653589792"/>
  </joint>

  <!-- ROS optical frame -->
  <link name="arducam_optical_frame"/>

  <joint name="arducam_to_optical" type="fixed">
    <parent link="arducam_link"/>
    <child link="arducam_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <!-- ===================== SUCTION CUPS ===================== -->
  <link name="cup_0">
    <visual>
      <geometry>
        <mesh filename="package://match/meshes/suctioncup_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://match/meshes/suctioncup_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="cup_1">
    <visual>
      <geometry>
        <mesh filename="package://match/meshes/suctioncup_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://match/meshes/suctioncup_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="cup_2">
    <visual>
      <geometry>
        <mesh filename="package://match/meshes/suctioncup_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://match/meshes/suctioncup_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="cup_3">
    <visual>
      <geometry>
        <mesh filename="package://match/meshes/suctioncup_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://match/meshes/suctioncup_link-v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="arm_to_cup_0" type="fixed">
    <parent link="arm_link"/>
    <child link="cup_0"/>
    <origin xyz="0.075 0.0255 0.0027067937990953" rpy="1.5707963267948966 0 0"/>
  </joint>

  <joint name="arm_to_cup_1" type="fixed">
    <parent link="arm_link"/>
    <child link="cup_1"/>
    <origin xyz="0.025 0.0255 0.0027067937990953" rpy="1.5707963267948966 0 0"/>
  </joint>

  <joint name="arm_to_cup_2" type="fixed">
    <parent link="arm_link"/>
    <child link="cup_2"/>
    <origin xyz="-0.025 0.0255 0.0027067937990953" rpy="1.5707963267948966 0 0"/>
  </joint>

  <joint name="arm_to_cup_3" type="fixed">
    <parent link="arm_link"/>
    <child link="cup_3"/>
    <origin xyz="-0.075 0.0255 0.0027067937990953" rpy="1.5707963267948966 0 0"/>
  </joint>

</robot>
