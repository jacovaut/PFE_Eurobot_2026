<?xml version="1.0"?>
<robot name="pfe_robot">

  <!-- ===================== WORLD ===================== -->
  <link name="map"/>

  <!-- ===================== ROS BASE ===================== -->
  <link name="base_link"/>

  <joint name="map_to_base" type="fixed">
    <parent link="map"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== CAD WRAPPER ===================== -->
  <link name="base_cad">
    <inertial>
      <origin xyz="-0.1806532478764334 0.10959136535685834 -0.09958100133613353" rpy="0 0 0"/>
      <mass value="10.846844826170994"/>
      <inertia ixx="0.1137300898429841" iyy="0.15506270343665957" izz="0.1525596007466387"
               ixy="0.0002636196730894534" iyz="0.0002706724915273537" ixz="0.008689234245133912"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://pfe/meshes/base_link-v5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://pfe/meshes/base_link-v5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Fusion: +x backward, +y right -->
  <joint name="base_to_cad" type="fixed">
    <parent link="base_link"/>
    <child link="base_cad"/>
    <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
  </joint>

